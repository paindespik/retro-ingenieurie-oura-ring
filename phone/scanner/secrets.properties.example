# Secrets de build de l'app Oura — copier en `secrets.properties` (gitignoré)
# et renseigner les valeurs de VOTRE installation.
#
#   cp secrets.properties.example secrets.properties
#
# Gradle les injecte dans BuildConfig ; rien de tout ceci n'entre dans le dépôt.
# À défaut de fichier, les variables d'environnement de même nom sont utilisées.

# Portail (vhost nginx avec Basic Auth + TLS)
OURA_SERVER=https://oura.example.com

# Identifiants Basic Auth du portail (fichier htpasswd côté nginx)
WEB_USER=oura
WEB_PASS=CHANGE_ME

# En-tête X-Oura-Token : doit correspondre à OURA_PHONE_TOKEN côté serveur
# (/etc/oura/ingest.env, lu par oura-web.service)
PHONE_TOKEN=CHANGE_ME

# Numéro de série de l'anneau (visible avec `oura info`)
RING_SERIAL=CHANGE_ME
