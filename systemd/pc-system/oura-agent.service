[Unit]
Description=Agent d'appairage BlueZ auto-accept (anneau Oura)
Documentation=man:bluetoothd(8)
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/oura-agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
