# La dérivation est idempotente (INSERT OR REPLACE) : les passages répétés
# ne font que rafraîchir les nuits. L'analyse bedtime_period de l'anneau
# n'arrive qu'après la fin du sommeil (premier sync post-réveil, puis
# révisions pendant ~1 h) : les passages toutes les 30 min (06:00-23:30)
# font apparaître la nuit précédente dans l'heure qui suit le réveil,
# avec sa version finale un passage plus tard. Le run 05:35 reste le filet
# de sécurité (dérive tout ce qui est déjà présent, ex. nuits finissant
# avant 06:00 ou données synchronisées plus tôt dans la journée).
[Unit]
Description=oura: nightly 05:35 + 30 min de 06:00 à 23:30

[Timer]
OnCalendar=*-*-* 05:35:00
OnCalendar=*-*-* 06..23:00/30
Persistent=true

[Install]
WantedBy=timers.target
